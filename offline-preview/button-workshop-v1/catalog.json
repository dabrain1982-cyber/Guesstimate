  "material_descriptions": {
    "wood": "Holz mit Maserung, je nach Stil gemalt oder als Materialstruktur.",
    "wood-aged": "Dunkles altes Nussbaumholz mit feiner Maserung, Patina und Gebrauchsspuren. Für den Black-Jack-Tisch entworfen.",
    "stone": "Stein und Schiefer mit ihrer vorhandenen Materialstruktur.",
    "metal": "Metall mit Gebrauchsspuren und Lichtwirkung.",
    "plain": "Für die einfarbigen Aktionen auf der Startseite und in Lobbys. Die Grundfarbe bestimmt die Fläche; keine Holz-, Stein- oder Metallstruktur.",
    "gradient": "Für die zweifarbigen Flächen der Karten- und Würfelaktionen. Grundfarbe und zweite Verlaufsfarbe bestimmen den Verlauf.",
    "translucent": "Für durchscheinende Nebenaktionen. Deckkraft verändert nur die Fläche; die Beschriftung bleibt sichtbar. Das Aussehen hängt vom Hintergrund ab."
  },
  "style_descriptions": {
    "comic": "Gemalte Farbflächen, vereinfachte Materialspuren und kräftige dunkle Konturen. Holz, Stein und Metall werden zeichnerisch interpretiert.",
    "natural": "Die echte Holz-, Stein- oder Metallstruktur steht im Vordergrund, mit weicher Beleuchtung und feinen Materialkanten.",
    "minimal": "Flächige Farben und einfache grafische Materialzeichen: Holzlinien, Steinflächen oder Metallstreifen. Ohne fotografische Textur."
  },
