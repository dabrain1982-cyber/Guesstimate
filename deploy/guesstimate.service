[Unit]
Description=Stormseed´s Guesstimate daily quiz
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=guesstimate
Group=guesstimate
WorkingDirectory=/srv/guesstimate
Environment=QUIZ_SECRET_KEY_FILE=/etc/guesstimate.secret
Environment=QUIZ_DATABASE=/var/lib/guesstimate/quiz.sqlite3
Environment="QUIZ_GAME_NAME=Stormseed´s Guesstimate"
Environment=QUIZ_URL_PREFIX=/guesstimate
Environment=QUIZ_PUBLIC_URL=https://igroup.it-sauther.de/guesstimate
EnvironmentFile=-/etc/guesstimate.env
Environment=QUIZ_MAIL_PASSWORD_FILE=/etc/guesstimate-mail.secret
ExecStart=/srv/guesstimate/.venv/bin/python -m gunicorn --workers 2 --timeout 60 --bind 127.0.0.1:8765 app:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/guesstimate
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
